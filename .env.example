# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=moviemix
DATABASE_URL=postgresql://admin:change_me@db:5432/moviemix

# Backend
PORT=8000
JWT_SECRET=change_me_min_32_chars
RECS_URL=http://recommender:8001
BACKEND_ORIGIN=
CORS_ORIGIN=
DATABASE_REQUIRE_SSL=0
DATABASE_REJECT_UNAUTHORIZED=0
FRONTEND_ORIGIN=http://localhost:3000

# External APIs
OMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://localhost:8000/integrations/trakt/cb
TRAKT_ACCESS_TOKEN=
TRAKT_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Feature flags
ENABLE_TRAKT_IMPORT=0
ENABLE_WATCH_LINKS=0
NEXT_PUBLIC_ENABLE_WATCH_LINKS=0
ENABLE_AB_TEST=0
NEXT_PUBLIC_ENABLE_AB_TEST=0
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=0

# Frontend helper base URL (usually empty in Docker)
NEXT_PUBLIC_API_BASE=

# Production domain / TLS
APP_DOMAIN=movie.example.com
ACME_EMAIL=you@example.com
